# --- Frontend (Vite client, public) ---
# Same-origin API paths. No secret here, ever.
VITE_INFINITY_JOIN_ENDPOINT=/api/join
VITE_AIVEX_REGISTER_ENDPOINT=/api/aivex/register

# --- Backend only (Vercel Function, NEVER exposed to the browser) ---
# Set real values in .env.local (local dev) and in
# Vercel → Settings → Environment Variables (production).
# NEVER prefix these with VITE_/INFINITY_/AIVEX_ and NEVER commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
