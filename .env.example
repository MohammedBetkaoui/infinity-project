# --- Frontend (Vite client, public) ---
# Same-origin API paths. No secret here, ever.
VITE_INFINITY_JOIN_ENDPOINT=/api/join
VITE_AIVEX_REGISTER_ENDPOINT=/api/aivex/register

# --- Backend only (Vercel Function, NEVER exposed to the browser) ---
# Set real values in .env.local (local dev) and in
# Vercel → Settings → Environment Variables (production).
# NEVER prefix these with VITE_/INFINITY_/AIVEX_ and NEVER commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Administration authentication (server only) ---
# Keep disabled until the admin migration is applied and the first account is
# created with `npm run admin:create-user` from a trusted operator machine.
ADMIN_AUTH_ENABLED=false
# Enable only after 20260926120000_admin_join_applications.sql is applied.
ADMIN_JOIN_API_ENABLED=false
# Enable only after 20260927120000_admin_aivex_operations.sql is applied.
ADMIN_AIVEX_API_ENABLED=false
# Generate at least 32 random bytes, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_RATE_LIMIT_SECRET=
# Optional comma-separated exact origins for unusual reverse-proxy/dev setups.
# Same-origin production requests require no entry here.
ADMIN_ALLOWED_ORIGINS=
