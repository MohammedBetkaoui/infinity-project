# --- Frontend (Vite client, public) ---
# Same-origin API paths. No secret here, ever.
VITE_INFINITY_JOIN_ENDPOINT=/api/join
VITE_AIVEX_REGISTER_ENDPOINT=/api/aivex/register
# Cloudflare Turnstile SITE key (public by design) for the Join form.
# Pair it with TURNSTILE_SECRET_KEY below. Read at build time: redeploy after changing it.
VITE_TURNSTILE_SITE_KEY=

# --- Backend only (Vercel Function, NEVER exposed to the browser) ---
# Set real values in .env.local (local dev) and in
# Vercel → Settings → Environment Variables (production).
# NEVER prefix these with VITE_/INFINITY_/AIVEX_ and NEVER commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile SECRET key, used only by api/join.js (Siteverify).
# Required on every Vercel deployment: without it the Join form answers 503
# instead of accepting unverified submissions. Optional for local dev only.
TURNSTILE_SECRET_KEY=

# Upstash Redis REST credentials for the deployment-wide Join rate limit
# (8 requests / 10 minutes / client). Without them, or if Redis is down,
# each serverless instance falls back to its own in-memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Key for hashing client IP addresses into rate-limit keys (no raw IP is
# stored in Redis). At least 32 random bytes, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_HASH_SECRET=

# --- Administration authentication (server only) ---
# Keep disabled until the admin migration is applied and the first account is
# created with `npm run admin:create-user` from a trusted operator machine.
ADMIN_AUTH_ENABLED=false
# Enable only after 20260926120000_admin_join_applications.sql is applied.
ADMIN_JOIN_API_ENABLED=false
# Enable only after 20260929120000_admin_members_staff_directory.sql is applied.
ADMIN_PEOPLE_API_ENABLED=false
# Enable only after 20260927120000_admin_aivex_operations.sql is applied.
ADMIN_AIVEX_API_ENABLED=false
# Generate at least 32 random bytes, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_RATE_LIMIT_SECRET=
# Optional comma-separated exact origins for unusual reverse-proxy/dev setups.
# Same-origin production requests require no entry here.
ADMIN_ALLOWED_ORIGINS=
